# Server
PORT=4000
# Comma-separated origins allowed to call the API (the web app).
WEB_ORIGIN=http://localhost:3000
# Set to "true" behind HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false

# Database
DATABASE_URL=postgresql://oku:oku@localhost:5432/oku

# Storage: "disk" keeps files under DATA_DIR; "s3" uses any S3-compatible bucket.
STORAGE_DRIVER=disk
DATA_DIR=./data
# S3 settings (only when STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=oku
S3_ACCESS_KEY=oku
S3_SECRET_KEY=okuokuoku
S3_FORCE_PATH_STYLE=true

# Media tools
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Font used for titles and names on exported covers.
FONT_FILE=

# WebRTC. STUN is enough on most home networks; production needs a TURN server
# (coturn, Twilio, Cloudflare) or calls behind strict NATs will fail to connect.
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
